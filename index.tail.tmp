
    // --- 磁性游標 (Magnetic Cursor) 邏輯 ---
    if (window.matchMedia("(pointer: fine)").matches) {
      const dot  = document.getElementById('cursor-dot');
      const ring = document.getElementById('cursor-ring');

      let mouseX = -100, mouseY = -100;
      let dotX = -100, dotY = -100;
      let ringX = -100, ringY = -100;

      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      function animateCursor(){
        dotX  += (mouseX - dotX) * 0.35;
        dotY  += (mouseY - dotY) * 0.35;
        ringX += (mouseX - ringX) * 0.18;
        ringY += (mouseY - ringY) * 0.18;
        dot.style.transform  = `translate(${dotX}px, ${dotY}px) translate(-50%, -50%)`;
        ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;
        requestAnimationFrame(animateCursor);
      }
      requestAnimationFrame(animateCursor);

      document.addEventListener('mouseover', (e) => {
        const target = e.target.closest('a, button, .toggle, .btn, .card, .productHero, .otherCard, .panel, .linkPill');
        if (target) {
          ring.classList.add('hovered');
          dot.classList.add('hovered');
        }
      });

      document.addEventListener('mouseout', (e) => {
        const target = e.target.closest('a, button, .toggle, .btn, .card, .productHero, .otherCard, .panel, .linkPill');
        if (target) {
          ring.classList.remove('hovered');
          dot.classList.remove('hovered');
        }
      });
    } // 這裡結束 if 判斷

    // ── Hamburger menu ─────────────────────────────────────────
    const hamburger  = document.getElementById('hamburger');
    const mobileNav  = document.getElementById('mobile-nav');
    let menuOpen = false;

    function openMobileNav(){
      menuOpen = true;
      hamburger.classList.add('open');
      hamburger.setAttribute('aria-expanded','true');
      mobileNav.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeMobileNav(){
      menuOpen = false;
      hamburger.classList.remove('open');
      hamburger.setAttribute('aria-expanded','false');
      mobileNav.classList.remove('open');
      document.body.style.overflow = '';
    }
    hamburger.addEventListener('click', ()=> menuOpen ? closeMobileNav() : openMobileNav());
    document.addEventListener('keydown', e=>{ if(e.key==='Escape' && menuOpen) closeMobileNav(); });

  </script>


  <!-- ════════════ Flow Studio enhancements (reveal / form / WYSIWYG editor) ════════════ -->
  <script>
  (function(){
    "use strict";

    /* ---------- 1. Scroll reveal ---------- */
    try {
      var revealSel = "#works .productHero, #process .step, #process .processVisuals, #others .otherCard, #about .panel, #contact .panel, #concepts article, .sectionTitle";
      var revealEls = Array.prototype.slice.call(document.querySelectorAll(revealSel));
      revealEls.forEach(function(el){ el.classList.add("reveal"); });
      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
        revealEls.forEach(function(el){ io.observe(el); });
      } else {
        revealEls.forEach(function(el){ el.classList.add("in"); });
      }
    } catch(err){}

    /* ---------- 2. Contact form (Formspree-compatible, no page reload) ---------- */
    try {
      var form = document.getElementById("contactForm");
      if (form) {
        var note = document.getElementById("cf-note");
        form.addEventListener("submit", function(ev){
          var action = form.getAttribute("action") || "";
          if (action.indexOf("your-id") !== -1) {
            ev.preventDefault();
            note.textContent = "尚未設定收件端點:請到 formspree.io 註冊,把 action 換成你的網址。";
            note.className = "formNote err";
            return;
          }
          ev.preventDefault();
          note.textContent = "送出中…"; note.className = "formNote";
          fetch(action, { method:"POST", body:new FormData(form), headers:{ "Accept":"application/json" } })
            .then(function(r){
              if (r.ok){ form.reset(); note.textContent = "已送出,謝謝!我會盡快回覆。"; note.className = "formNote ok"; }
              else { note.textContent = "送出失敗,請改用上方 Email 或電話。"; note.className = "formNote err"; }
            })
            .catch(function(){ note.textContent = "網路異常,請改用上方 Email 或電話。"; note.className = "formNote err"; });
        });
      }
    } catch(err){}

    /* ---------- 3. WYSIWYG edit mode (only when ?edit=1) ---------- */
    if (!/[?&]edit=1\b/.test(location.search)) return;

    var EXCLUDE = "#bg, .musicPlayer, #motionToggle, .hamburger, script, style, noscript, .mobile-nav";
    function isExcluded(el){ return !!(el.closest && el.closest(EXCLUDE)); }

    var TEXT_TAGS = ["H1","H2","H3","H4","H5","H6","P","LI","BLOCKQUOTE","FIGCAPTION","B","STRONG","EM","SPAN","A","BUTTON"];
    var editTexts = [], editImgs = [], idCounter = 0;

    function walk(node){
      for (var i=0;i<node.children.length;i++){
        var el = node.children[i];
        if (isExcluded(el)) continue;
        if (el.tagName === "IMG"){
          el.setAttribute("data-fsid", "i"+(idCounter++));
          editImgs.push(el);
          continue;
        }
        var isTextEl = TEXT_TAGS.indexOf(el.tagName) !== -1;
        if (isTextEl && el.childElementCount === 0 && el.textContent.trim().length){
          el.setAttribute("data-fsid", "t"+(idCounter++));
          editTexts.push(el);
        } else {
          walk(el);
        }
      }
    }
    walk(document.body);

    var imgMeta = {}; // fsid -> {filename, dataUrl}

    var st = document.createElement("style");
    st.id = "fs-edit-style";
    st.textContent =
      ".fs-edit [contenteditable='true']{outline:1px dashed rgba(120,200,255,0);transition:outline-color .15s, background .15s;border-radius:4px;cursor:text;}"+
      ".fs-edit [contenteditable='true']:hover{outline-color:rgba(120,200,255,.55);background:rgba(120,200,255,.06);}"+
      ".fs-edit [contenteditable='true']:focus{outline:1px solid #59b6ff;background:rgba(89,182,255,.10);}"+
      ".fs-edit img[data-fsid]{cursor:pointer;transition:outline .15s;outline:2px solid transparent;outline-offset:2px;}"+
      ".fs-edit img[data-fsid]:hover{outline:2px solid #59b6ff;}"+
      ".fs-imgbadge{position:fixed;z-index:99999;background:#59b6ff;color:#04121f;font:600 11px/1 ui-sans-serif,system-ui;padding:5px 8px;border-radius:6px;pointer-events:none;transform:translate(-50%,-130%);white-space:nowrap;}";
    document.head.appendChild(st);
    document.documentElement.classList.add("fs-edit");

    editTexts.forEach(function(el){
      el.setAttribute("contenteditable","true");
      el.setAttribute("spellcheck","false");
      el.addEventListener("input", onDirty);
      el.addEventListener("keydown", function(e){
        if (e.key === "Enter" && /^H[1-6]$/.test(el.tagName)){ e.preventDefault(); el.blur(); }
      });
    });

    var picker = document.createElement("input");
    picker.type = "file"; picker.accept = "image/*"; picker.style.display = "none";
    document.body.appendChild(picker);
    var pendingImg = null;
    editImgs.forEach(function(img){
      img.addEventListener("click", function(e){ e.preventDefault(); pendingImg = img; picker.value=""; picker.click(); });
      img.addEventListener("mouseenter", function(e){ showBadge(e, "點擊更換圖片"); });
      img.addEventListener("mousemove", moveBadge);
      img.addEventListener("mouseleave", hideBadge);
    });
    picker.addEventListener("change", function(){
      var f = picker.files && picker.files[0]; if (!f || !pendingImg) return;
      var fsid = pendingImg.getAttribute("data-fsid");
      var url = URL.createObjectURL(f);
      pendingImg.src = url;
      var reader = new FileReader();
      reader.onload = function(){ imgMeta[fsid] = { filename: f.name, dataUrl: reader.result }; onDirty(); };
      reader.readAsDataURL(f);
    });

    var badge = document.createElement("div"); badge.className="fs-imgbadge"; badge.style.display="none";
    document.body.appendChild(badge);
    function showBadge(e,txt){ badge.textContent=txt; badge.style.display="block"; moveBadge(e); }
    function moveBadge(e){ badge.style.left=e.clientX+"px"; badge.style.top=e.clientY+"px"; }
    function hideBadge(){ badge.style.display="none"; }

    document.addEventListener("click", function(e){
      var a = e.target.closest && e.target.closest("a");
      if (a){ e.preventDefault(); }
    }, true);
    document.addEventListener("submit", function(e){ e.preventDefault(); }, true);

    function parentPost(msg){ if (window.parent && window.parent !== window) window.parent.postMessage(msg, "*"); }

    var dirtyTimer = null;
    function onDirty(){
      parentPost({ type:"fs-dirty" });
      clearTimeout(dirtyTimer);
      dirtyTimer = setTimeout(function(){ parentPost({ type:"fs-autosave", patch: collectPatch() }); }, 600);
    }

    function collectPatch(){
      var texts = {}, imgs = {};
      editTexts.forEach(function(el){ texts[el.getAttribute("data-fsid")] = el.innerHTML; });
      Object.keys(imgMeta).forEach(function(k){ imgs[k] = imgMeta[k]; });
      return { texts: texts, imgs: imgs };
    }

    function applyPatch(patch){
      if (!patch) return;
      if (patch.texts){ editTexts.forEach(function(el){ var v=patch.texts[el.getAttribute("data-fsid")]; if (v!=null) el.innerHTML=v; }); }
      if (patch.imgs){ editImgs.forEach(function(img){ var m=patch.imgs[img.getAttribute("data-fsid")]; if (m){ imgMeta[img.getAttribute("data-fsid")]=m; img.src=m.dataUrl; } }); }
    }

    function exportHTML(){
      var docEl = document.documentElement.cloneNode(true);
      docEl.classList.remove("fs-edit");
      var styleNode = docEl.querySelector("#fs-edit-style"); if (styleNode) styleNode.remove();
      var b = docEl.querySelector(".fs-imgbadge"); if (b) b.remove();
      Array.prototype.forEach.call(docEl.querySelectorAll("input[type='file']"), function(n){ if(!n.name) n.remove(); });
      Array.prototype.forEach.call(docEl.querySelectorAll("[contenteditable]"), function(n){ n.removeAttribute("contenteditable"); n.removeAttribute("spellcheck"); });
      // map replaced images BEFORE stripping data-fsid (match by index)
      var images = [];
      var liveImgs = editImgs, cloneImgs = Array.prototype.slice.call(docEl.querySelectorAll("img"));
      liveImgs.forEach(function(img, idx){
        var fsid = img.getAttribute("data-fsid"); var m = imgMeta[fsid];
        if (m && cloneImgs[idx]){
          cloneImgs[idx].setAttribute("src", "images/" + m.filename);
          images.push({ filename: m.filename, dataUrl: m.dataUrl });
        }
      });
      Array.prototype.forEach.call(docEl.querySelectorAll("[data-fsid]"), function(n){ n.removeAttribute("data-fsid"); });
      var html = "<!doctype html>\n" + docEl.outerHTML;
      return { html: html, images: images };
    }

    window.addEventListener("message", function(e){
      if (e.source !== window.parent) return;
      var d = e.data || {};
      if (d.type === "fs-load-draft"){ applyPatch(d.patch); }
      else if (d.type === "fs-request-export"){ parentPost(Object.assign({ type:"fs-export-result" }, exportHTML())); }
      else if (d.type === "fs-request-autosave"){ parentPost({ type:"fs-autosave", patch: collectPatch() }); }
    });

    parentPost({ type:"fs-ready", counts:{ texts: editTexts.length, imgs: editImgs.length } });
  })();
  </script>
</body>
</html>
